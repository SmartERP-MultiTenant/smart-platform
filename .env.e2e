DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saas-e2e
NEXTAUTH_URL=http://localhost:4002
NEXTAUTH_SECRET=secret
NEXTAUTH_SESSION_STRATEGY=database
AUTH_PROVIDERS=credentials,saml,idp-initiated
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=false
FEATURE_TEAM_API_KEY=true
FEATURE_TEAM_DELETION=true
FEATURE_TEAM_PAYMENTS=true
CONFIRM_EMAIL=false
HIDE_LANDING_PAGE=false
GROUP_PREFIX=smart-platform-
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false
APP_URL=http://localhost:4002
JACKSON_PRODUCT_ID=smart-platform
JACKSON_WEBHOOK_SECRET=your-webhook-secret
JACKSON_API_KEY=secret
MOCKSAML_ORIGIN=http://localhost:4000
# Explicitly disabled: the dev .env sets real reCAPTCHA keys, which would leak
# into the e2e server and activate a flaky Google verification gate on signup.
# These empty values shadow the dev .env ones.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Email is disabled by default in e2e: the dev .env sets real Resend SMTP
# credentials, which would leak into the e2e server (Next.js auto-loads .env
# for unset vars) and Resend rejects example.com (reserved test domain) with a
# 550, turning the signup API into a 500. These empty values shadow the dev
# .env ones. To exercise email flows (welcome, verify, invites) instead:
#   docker compose up -d mailpit     # SMTP on :1025, web UI on :8025
#   EMAIL_ENABLED=true
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASSWORD=
#   SMTP_FROM=no-reply@localhost
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Same leak class as the email block: the dev .env carries real ERP service
# credentials (superadmin password, platform M2M billing key). The shadow
# values below keep the real ones from reaching the e2e server — the stub
# (erp-stub.cjs) does not check them.
ERP_ADMIN_PASSWORD=

# P5.4: deliberately NON-EMPTY, and deliberately a dummy. Every
# `/api/admin/subscriptions/*` route short-circuits with
# `ApiError(503, 'erp-not-configured')` when this value is falsy — BEFORE team
# resolution and before the audit row is opened — so an empty value made the
# ticket's headline criterion ("every mutation produces an audit row")
# unreachable in e2e. The value is never a credential: it shadows the dev
# .env's real M2M key (dotenv loading never overrides an existing key, so the
# real one cannot reach the e2e server) and the hermetic stub accepts any
# non-empty string. Never replace it with a real key — the point of the shadow
# is that a leaked secret has nowhere to go. CI pre-sets the same dummy in
# .github/workflows/main.yml (the loader above is skipped when CI is set), so
# the two values MUST stay identical or the mutation path would 503 in exactly
# one of the two environments.
ERP_PLATFORM_API_KEY=e2e-platform-api-key

# Point the e2e server's ERP calls at the hermetic stub started by Playwright
# (playwright.config.ts webServer entry; erp-stub.cjs on 127.0.0.1:4100). CI
# pre-sets the same value in .github/workflows/main.yml (the loader below is
# skipped when CI is set).
ERP_API_URL=http://127.0.0.1:4100/api

# e2e server runs `next start` (NODE_ENV=production) so the ERP token encryption
# key must be set or lib/crypto/erpToken.ts throws. Dummy value — e2e never
# exercises ERP token flows today; kept as insurance for future specs.
ERP_TOKEN_ENCRYPTION_KEY=e2e-only-encryption-key-32b

# P4.14: the ERP login handoff target is composed from these values
# (lib/erp/handoff.ts) and must pass the host allowlist. Without an explicit
# client URL the target renders as "undefined/auth/login" and the funnel /
# payment-success CTA stays hidden, so pin the local Angular client here and
# in the CI env (see P4.9's ERP_API_URL note for the parity rule).
ERP_CLIENT_URL=http://localhost:4200
ERP_CLIENT_LOGIN_PATH=/auth/login
ERP_BASE_DOMAIN=smartapro.com
