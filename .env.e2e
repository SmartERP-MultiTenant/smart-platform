DATABASE_URL=postgresql://postgres:postgres@localhost:5433/saas-e2e
NEXTAUTH_URL=http://localhost:4002
NEXTAUTH_SECRET=secret
NEXTAUTH_SESSION_STRATEGY=database
AUTH_PROVIDERS=credentials,saml,idp-initiated
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=false
FEATURE_TEAM_API_KEY=true
FEATURE_TEAM_DELETION=true
FEATURE_TEAM_PAYMENTS=true
CONFIRM_EMAIL=false
HIDE_LANDING_PAGE=false
GROUP_PREFIX=smart-platform-
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false
APP_URL=http://localhost:4002
JACKSON_PRODUCT_ID=smart-platform
JACKSON_WEBHOOK_SECRET=your-webhook-secret
JACKSON_API_KEY=secret
MOCKSAML_ORIGIN=http://localhost:4000
# Explicitly disabled: the dev .env sets real reCAPTCHA keys, which would leak
# into the e2e server and activate a flaky Google verification gate on signup.
# These empty values shadow the dev .env ones.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Explicitly shadowed: the dev .env sets real Resend sandbox SMTP creds, which
# would leak into the e2e webServer. The sandbox key rejects non-verified
# @example.com recipients with 550, breaking the invite-members e2e flow.
# These empty values shadow the dev .env ones so sendEmail() no-ops (same
# behavior as CI, which defines no SMTP vars).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=