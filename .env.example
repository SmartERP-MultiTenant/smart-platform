NEXTAUTH_URL=http://localhost:4002

# You can use openssl to generate a random 32 character key: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-32-char-random-string
 
# SMTP / Email settings 
# Master switch for outgoing email (transactional + NextAuth email provider).
# Keep false until SMTP is configured. For a local mail sink see the `mailpit`
# service in docker-compose.yml (SMTP :1025, web UI :8025).
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# If you are using Docker, you can retrieve the values from: docker-compose.yml
DATABASE_URL=postgresql://<USER-HERE>:<PASSWORD-HERE>@localhost:5432/<DATABASE NAME HERE>

APP_URL=http://localhost:4002

SVIX_URL=https://api.eu.svix.com
SVIX_API_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RETRACED_URL=
RETRACED_API_KEY=
RETRACED_PROJECT_ID=

# Hide landing page and redirect to login page
HIDE_LANDING_PAGE=false

# SSO groups can be prefixed with this identifier in order to avoid conflicts with other groups.
# For example smart-platform-admin would be resolved to admin, smart-platform-member would be resolved to member, etc.
GROUP_PREFIX=smart-platform-

# Users will need to confirm their email before accessing the app feature
CONFIRM_EMAIL=false

# Disable non-business email signup
DISABLE_NON_BUSINESS_EMAIL_SIGNUP=false

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=

# If you want to use Jackson that is self-hosted or our SaaS instead of the embedded Jackson
# JACKSON_URL=http://localhost:5225
# JACKSON_EXTERNAL_URL=https://sso.eu.boxyhq.com
# JACKSON_API_KEY=secret
# JACKSON_PRODUCT_ID=smart-platform
# JACKSON_WEBHOOK_SECRET=your-webhook-secret

# Enable Auth providers (comma separated)
# Supported providers: github, google, saml, email, credentials, idp-initiated
AUTH_PROVIDERS=

# OpenTelemetry
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_HEADERS=
# OTEL_EXPORTER_OTLP_METRICS_PROTOCOL=grpc
# If you have any issues with using the otel exporter and want to enable debug logs uncomment below
# OTEL_EXPORTER_DEBUG=true 
OTEL_PREFIX=smart-platform.saas

NEXT_PUBLIC_TERMS_URL='/terms'
NEXT_PUBLIC_PRIVACY_URL='/privacy'

NEXT_PUBLIC_DARK_MODE=false

# Team feature
FEATURE_TEAM_SSO=true
FEATURE_TEAM_DSYNC=true
FEATURE_TEAM_AUDIT_LOG=true
FEATURE_TEAM_WEBHOOK=true
FEATURE_TEAM_API_KEY=true
FEATURE_TEAM_DELETION=true
# Set to true only when the legacy Stripe team-billing surface is enabled (dormant since Phase 2)
FEATURE_TEAM_PAYMENTS=false

# Google reCAPTCHA
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Decide which session strategy (jwt or database) to use with NextAuth
NEXTAUTH_SESSION_STRATEGY=jwt

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_TRACE_SAMPLE_RATE=0.0 # https://develop.sentry.dev/sdk/performance/#tracessamplerate
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=

# Sentry CLI (Set these values if you want to upload source maps to Sentry)
SENTRY_URL=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Max login attempts before account is locked
MAX_LOGIN_ATTEMPTS=5

# Set this to receive Slack notifications, https://hooks.slack.com/services/xxx/xxx/xxx
SLACK_WEBHOOK_URL=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Support URL (WhatsApp, mailto:, or support desk).
# Must be the owner-approved support link (ticket 86cbbpyey) — leave empty until
# it is approved on the ticket; never commit a placeholder number. When empty,
# the landing header / footer / trust-strip contact CTAs are omitted.
NEXT_PUBLIC_SUPPORT_URL=

# X/Twitter handle emitted as `twitter:site` on OpenGraph cards (SEO.tsx).
# Enter it with or without the leading '@' — it is normalised to a single '@'.
# Leave empty until an owner-approved brand handle exists: when unset,
# `twitter:site` is omitted rather than advertising a handle we cannot verify.
NEXT_PUBLIC_TWITTER_HANDLE=

# Mobile app store links for the landing "get the app" badges (MobileSection.tsx).
# The apps are not published yet, so leave both empty: the badges then render as
# non-interactive "coming soon" affordances instead of misleading store links.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# SmartERP integration (local dev defaults)
ERP_API_URL=http://localhost:5001/api
ERP_CLIENT_URL=http://localhost:4200
ERP_CLIENT_LOGIN_PATH=/auth/login
ERP_BASE_DOMAIN=smartapro.com

# Required in production (encrypt/decrypt of Team.erpAccessToken throws when unset).
# Generate with: openssl rand -base64 32. Key separation: NEXTAUTH_SECRET is NOT used.
# The enc:v1:<keyId> envelope supports future rotation without a format change.
ERP_TOKEN_ENCRYPTION_KEY=

# Guard for scheduled routes like /api/cron/renewal-reminders. Required for the route
# to function — it returns 503 when unset. Header auth only (Bearer / x-cron-secret).
CRON_SECRET=

# SuperAdmin service account for extend/cancel — dev seed credentials, REPLACE in prod
ERP_ADMIN_USERNAME=superadmin@example.com
ERP_ADMIN_PASSWORD=

# Must match ERP Platform:ApiKey (env override name: Platform__ApiKey) — never commit a real key
ERP_PLATFORM_API_KEY=

# Platform admin bootstrap email for scripts/seed-platform-admin.ts (non-secret).
# Overrides with --email=<address> at invocation. Never commit a real admin email.
PLATFORM_ADMIN_EMAIL=
