{
  "name": "smart-platform",
  "version": "0.1.0",
  "private": true,
  "prisma": {
    "seed": "ts-node ./prisma/seed.ts"
  },
  "scripts": {
    "dev": "next dev --port 4002",
    "build": "prisma generate && prisma db push && next build",
    "start": "next start --port 4002",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint -c eslint.config.cjs ./",
    "check-unused": "npx knip",
    "format": "prettier --write .",
    "test-all": "npm run check-format && npm run check-lint && npm run check-types && npm run build",
    "playwright:update": "playwright install && playwright install-deps",
    "test:e2e": "playwright test -x",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --env=jsdom",
    "build-ci": "next build",
    "sync-stripe": "node --env-file .env scripts/sync-stripe.js",
    "check-locale": "node scripts/check-locale.js",
    "context:validate": "node scripts/check-context.js",
    "delete-team": "node --env-file .env scripts/delete-team.js",
    "seed:platform-admin": "node --env-file .env -r ts-node/register scripts/seed-platform-admin.ts"
  },
  "dependencies": {
    "@boxyhq/metrics": "0.2.15",
    "@boxyhq/react-ui": "3.6.0",
    "@boxyhq/saml-jackson": "26.2.0",
    "@heroicons/react": "2.2.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "6.19.3",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@retracedhq/logs-viewer": "2.10.1",
    "@retracedhq/retraced": "0.7.23",
    "@sentry/nextjs": "10.74.0",
    "@tailwindcss/typography": "0.5.20",
    "apexcharts": "^7.3.0",
    "bcryptjs": "3.0.3",
    "classnames": "2.5.1",
    "cookies-next": "6.1.1",
    "currency-symbol-map": "5.1.0",
    "formik": "2.4.9",
    "i18next": "25.10.10",
    "jose": "^6.2.12",
    "lucide-react": "^1.45.0",
    "micromatch": "4.0.8",
    "mixpanel-browser": "2.83.0",
    "next": "15.5.25",
    "next-auth": "4.24.15",
    "next-i18next": "15.4.3",
    "nodemailer": "7.0.13",
    "openid-client": "^6.8.8",
    "react": "18.3.1",
    "react-apexcharts": "^2.1.1",
    "react-daisyui": "5.0.5",
    "react-dom": "18.3.1",
    "react-google-recaptcha": "3.1.0",
    "react-hot-toast": "2.6.0",
    "react-i18next": "15.7.4",
    "sharp": "0.35.4",
    "slack-notify": "2.0.7",
    "stripe": "17.7.0",
    "svix": "1.99.1",
    "swr": "2.5.1",
    "yup": "1.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "30.0.0",
    "@types/micromatch": "4.0.10",
    "@types/node": "25.9.6",
    "@types/nodemailer": "7.0.4",
    "@types/react": "18.3.13",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "autoprefixer": "10.6.0",
    "daisyui": "4.12.24",
    "eslint": "9.39.2",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "globals": "^11.12.0",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "overrides": {
    "typeorm": {
      "mssql": ">=11.0.0"
    },
    "@react-email/components": {
      "prismjs": ">=1.30.0"
    }
  }
}
